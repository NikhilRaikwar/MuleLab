# ==================================================
# APP
# ==================================================
APP_ENV=development
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
DEMO_MODE=true
DEMO_SEED=424242

# ==================================================
# DATABASE
# ==================================================
# Local Docker: postgresql://mulelab:mulelab@localhost:5432/mulelab?sslmode=disable
# Neon runtime: pooled URL. Keep the real value only in .env / deployment secrets.
DATABASE_URL=
# Neon migration URL: direct/non-pooler URL. Keep secret and do not commit.
DATABASE_URL_DIRECT=
DATABASE_MAX_CONNS=5
DATABASE_MIN_CONNS=0
DATABASE_CONNECT_TIMEOUT_SECONDS=10
AUTO_MIGRATE=false

# ==================================================
# OPENROUTER
# ==================================================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_NAME=MuleLab
MODEL_REQUEST_TIMEOUT_SECONDS=25
MODEL_MAX_RETRIES=1
MODEL_MAX_OUTPUT_TOKENS=1200
MAX_MODEL_CALLS_PER_RUN=8
ZERO_COST_MODE=true
ALLOW_PAID_MODELS=false
DETERMINISTIC_MODEL_FALLBACK=true

# ==================================================
# AGENT / POLICY LIMITS
# ==================================================
MAX_AGENT_ITERATIONS=6
MAX_TOOL_CALLS_PER_RUN=12
MAX_RUN_DURATION_SECONDS=90
MAX_DAILY_PUBLIC_RUNS=50
MAX_EXPERIMENT_BUDGET_USD=100
HUMAN_APPROVAL_SPEND_THRESHOLD_USD=10
HUMAN_APPROVAL_AUDIENCE_THRESHOLD=100
HUMAN_APPROVAL_DISCOUNT_THRESHOLD_PCT=10
HUMAN_APPROVAL_CONFIDENCE_THRESHOLD=0.75
MAX_MESSAGES_PER_CONTACT_PER_7D=2
MAX_DISCOUNT_PCT=15

# ==================================================
# OBSERVABILITY
# ==================================================
OTEL_SERVICE_NAME=mulelab-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_ENABLED=false
TRACE_REDACTION_ENABLED=true

# ==================================================
# FRONTEND
# ==================================================
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8080/graphql
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_GITHUB_URL=

# ==================================================
# GCP DEPLOYMENT
# ==================================================
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_ARTIFACT_REPOSITORY=mulelab
GCP_API_SERVICE_NAME=mulelab-api
GCP_WEB_SERVICE_NAME=mulelab-web
MAX_CLOUD_RUN_INSTANCES=1
